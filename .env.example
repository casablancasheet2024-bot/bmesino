# Bmesino — configuration (copy to .env.local, or set in Vercel → Settings → Environment Variables)
# Leave a value empty to hide it: no fictional contact detail is ever displayed.

# Production domain, without trailing slash. Enables canonical URLs, sitemap host and robots sitemap.
NEXT_PUBLIC_SITE_URL=

# Optional overrides. Offices, phones and WhatsApp numbers supplied by the client live in `offices`
# (src/config/site.ts); the Morocco head office is the default for the values below.
# WhatsApp: international format, digits only or with + / spaces (e.g. +212 6XX XX XX XX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Inquiry form delivery (server-side only — never prefix with NEXT_PUBLIC_).
# Without these three values the form validates but tells the visitor the request was NOT sent,
# and offers WhatsApp / e-mail / copy alternatives.
RESEND_API_KEY=
# Recipient(s), comma-separated.
CONTACT_FORM_TO=
# Sender on a domain verified in Resend, e.g. "Bmesino <site@bmesino.com>".
CONTACT_FORM_FROM=
